# Application
NODE_ENV=development
PORT=5000

# Database
# Direct Neon connection - used by Prisma CLI and migrations
DATABASE_URL=
# Pooled Neon connection - used by the application at runtime
DATABASE_POOL_URL=

INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Authentication
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# CORS - allowed frontend origin
CLIENT_URL=http://localhost:5173