// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  LOST
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

// AUTHENTICATION

model User {
  id                 String       @id @default(cuid())
  username           String       @unique
  passwordHash       String
  role               UserRole     @default(EMPLOYEE)
  recordedAttendance Attendance[] @relation("AttendanceRecordedBy")
  mustChangePassword Boolean      @default(false)
  isActive           Boolean      @default(true)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  employee        Employee?
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]

  assetAssignmentsCreated  AssetAssignment[] @relation("AssetAssignedBy")
  assetAssignmentsReturned AssetAssignment[] @relation("AssetReturnedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// EMPLOYEE MANAGEMENT

model Employee {
  id                String            @id @default(cuid())
  fullName          String
  workEmail         String            @unique
  phone             String?
  jobTitle          String
  startDate         DateTime          @db.Date
  employmentStatus  EmploymentStatus  @default(ACTIVE)
  attendanceRecords Attendance[]
  assetAssignments  AssetAssignment[]
  assetFeedback     AssetFeedback[]

  // Authentication relationship
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Department relationship (optional)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([employmentStatus])
  @@map("employees")
}

// DEPARTMENT MANAGEMENT

model Department {
  id             String  @id @default(cuid())
  name           String
  normalizedName String  @unique
  description    String?
  isActive       Boolean @default(true)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model RefreshSession {
  id         String    @id @default(cuid())
  sessionId  String
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  date   DateTime         @db.Date
  status AttendanceStatus

  checkInAt  DateTime?
  checkOutAt DateTime?
  notes      String?

  recordedById String
  recordedBy   User   @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earlyArrival   Boolean @default(false)
  earlyDeparture Boolean @default(false)

  policyResumptionTime     String?
  policyClosingTime        String?
  policyGracePeriodMinutes Int?
  policyTimezone           String?
  policyWorkingDays        String[] @default([])

  @@unique([employeeId, date])
  @@index([date])
  @@index([status, date])
  @@index([recordedById])
  @@map("attendance")
}

model AttendanceSettings {
  id                 String   @id @default("default")
  resumptionTime     String?
  closingTime        String?
  gracePeriodMinutes Int      @default(0)
  timezone           String   @default("Africa/Lagos")
  workingDays        String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("attendance_settings")
}

// ASSET MANAGEMENT

model Asset {
  id           String         @id @default(cuid())
  assetId      String         @unique
  name         String
  type         String
  serialNumber String?
  condition    AssetCondition @default(GOOD)
  status       AssetStatus    @default(AVAILABLE)
  description  String?

  // Optional Cloudinary references
  imageUrl      String?
  imagePublicId String?
  fileUrl       String?
  filePublicId  String?

  assignments AssetAssignment[]
  feedback    AssetFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@map("assets")
}

model AssetAssignment {
  id         String @id @default(cuid())
  assetId    String
  employeeId String

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  assignedById String
  assignedBy   User   @relation("AssetAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  returnedById String?
  returnedBy   User?   @relation("AssetReturnedBy", fields: [returnedById], references: [id], onDelete: Restrict)

  feedback AssetFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, assetId, employeeId])
  @@index([assetId])
  @@index([employeeId])
  @@index([assignedAt])
  @@map("asset_assignments")
}

model AssetFeedback {
  id           String @id @default(cuid())
  assetId      String
  assignmentId String
  employeeId   String

  asset      Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignment AssetAssignment @relation(fields: [assignmentId, assetId, employeeId], references: [id, assetId, employeeId], onDelete: Restrict)
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  condition AssetCondition
  comment   String

  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
  @@index([assignmentId])
  @@index([employeeId])
  @@map("asset_feedback")
}
