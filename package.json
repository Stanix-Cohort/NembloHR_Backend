{
  "name": "nemblo-hr",
  "version": "1.0.0",
  "private": true,
  "description": "Internal HR and Administration Management System",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:client": "npm run dev --workspace=@nemblo/client",
    "dev:server": "npm run dev --workspace=@nemblo/server"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
